// Prisma schema for the Thabrez Tax Consulting platform.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// Enums
// =============================================================================

enum UserRole {
  CLIENT
  ASSOCIATE
  SENIOR_CA
  ADMIN
  FRONT_DESK
}

enum EntityType {
  INDIVIDUAL
  PROPRIETORSHIP
  PARTNERSHIP
  LLP
  PVT_LTD
  OPC
}

/// Covers every billable service the firm offers.
/// DeadlineType mirrors this enum so deadlines are strongly typed by service.
enum ServiceType {
  GST_FILING
  ITR_FILING
  TDS_FILING
  ROC_ANNUAL_COMPLIANCE
  COMPANY_REGISTRATION
  MSME_REGISTRATION
  TRADEMARK
  LOAN_SERVICE
  BOOKKEEPING
  OTHER
}

enum CaseStatus {
  RECEIVED
  IN_REVIEW
  FILED
  ACKNOWLEDGED
  CLOSED
}

/// Mirrors ServiceType — every service category can have a recurring deadline.
enum DeadlineType {
  GST_FILING
  ITR_FILING
  TDS_FILING
  ROC_ANNUAL_COMPLIANCE
  COMPANY_REGISTRATION
  MSME_REGISTRATION
  TRADEMARK
  LOAN_SERVICE
  BOOKKEEPING
  OTHER
}

enum DeadlineStatus {
  PENDING
  REMINDED
  COMPLETED
  OVERDUE
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
  LOST
}

enum ResourceType {
  ACT
  RULE
  FORM
  CIRCULAR
  BULLETIN
}

// =============================================================================
// Models
// =============================================================================

/// Platform user — one row per human regardless of role.
/// CLIENT users get a linked Client profile.
/// SENIOR_CA / ASSOCIATE / ADMIN / FRONT_DESK are staff.
model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  phone        String?  @unique
  passwordHash String?
  role         UserRole @default(CLIENT)
  mfaEnabled   Boolean  @default(false)
  mfaSecret    String?  // TOTP base-32 seed (encrypted at rest in prod)
  createdAt    DateTime @default(now())

  // Relations
  clientProfile   Client?    @relation("UserClient")
  assignedClients Client[]   @relation("AssignedCA")
  assignedCases   Case[]     @relation("CaseAssignee")
  sentMessages    Message[]
  uploadedDocs    Document[]
  auditLogs       AuditLog[]
  blogPosts       BlogPost[]
  adminReviews    AdminReview[]

  @@map("users")
}

/// Client profile — one per CLIENT-role user.
/// assignedCaId points to a staff User (SENIOR_CA or ASSOCIATE).
model Client {
  id           String     @id @default(cuid())
  userId       String     @unique
  user         User       @relation("UserClient", fields: [userId], references: [id], onDelete: Cascade)
  companyName  String?
  pan          String?    @unique
  gstin        String?    @unique
  entityType   EntityType @default(INDIVIDUAL)
  assignedCaId String?
  assignedCa   User?      @relation("AssignedCA", fields: [assignedCaId], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())

  // Relations
  cases     Case[]
  deadlines Deadline[]
  invoices  Invoice[]

  @@index([assignedCaId])
  @@map("clients")
}

/// A single filing / engagement. This is the primary unit of work.
model Case {
  id           String      @id @default(cuid())
  clientId     String
  client       Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  serviceType  ServiceType
  status       CaseStatus  @default(RECEIVED)
  assignedToId String?
  assignedTo   User?       @relation("CaseAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  dueDate      DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Relations
  documents Document[]
  deadlines Deadline[]
  messages  Message[]
  invoices  Invoice[]

  @@index([clientId])
  @@index([status])
  @@index([assignedToId])
  @@index([dueDate])
  @@index([serviceType])
  @@map("cases")
}

/// Document metadata only — binary content lives in S3.
/// s3Key is the full object path (e.g. "clients/cid_xyz/cases/case_abc/pan_card_v1.pdf").
model Document {
  id           String   @id @default(cuid())
  caseId       String
  case         Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  s3Key        String   @unique
  filename     String
  fileSize     Int      // bytes
  version      Int      @default(1)
  uploadedAt   DateTime @default(now())

  @@index([caseId])
  @@index([uploadedById])
  @@map("documents")
}

/// Compliance deadline — generated per client per obligation cycle.
/// caseId is nullable: a deadline can exist before a case is opened.
model Deadline {
  id             String         @id @default(cuid())
  clientId       String
  client         Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  caseId         String?
  case           Case?          @relation(fields: [caseId], references: [id], onDelete: SetNull)
  type           DeadlineType
  dueDate        DateTime
  status         DeadlineStatus @default(PENDING)
  reminderSentAt DateTime?
  remindedMarks  Int[]          @default([])
  createdAt      DateTime       @default(now())

  @@index([clientId])
  @@index([caseId])
  @@index([dueDate])
  @@index([status])
  @@map("deadlines")
}

/// Invoice issued for services. amount in INR (Decimal avoids float rounding).
model Invoice {
  id                String        @id @default(cuid())
  invoiceNumber     String?       @unique
  clientId          String
  client            Client        @relation(fields: [clientId], references: [id])
  caseId            String?
  case              Case?         @relation(fields: [caseId], references: [id], onDelete: SetNull)
  amount            Decimal       @db.Decimal(12, 2)
  status            InvoiceStatus @default(DRAFT)
  lineItems         Json?
  notes             String?
  dueDate           DateTime?
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?       @unique
  issuedAt          DateTime?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([issuedAt])
  @@map("invoices")
}

/// Per-case message between client and assigned CA.
/// Scoped to a case for auditability — not a general chat.
model Message {
  id        String   @id @default(cuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([caseId])
  @@index([senderId])
  @@map("messages")
}

/// Inbound lead from the marketing site contact / consultation form.
model Lead {
  id              String     @id @default(cuid())
  name            String
  phone           String
  email           String?
  serviceInterest String?    // free-text or ServiceType value
  message         String?
  notes           String?
  source          String?    // e.g. "contact_form", "google_ads", "referral"
  status          LeadStatus @default(NEW)
  createdAt       DateTime   @default(now())

  @@index([status])
  @@index([createdAt])
  @@map("leads")
}

/// Staff-authored blog posts / tax insights.
model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  body        String    // Markdown
  authorId    String
  author      User      @relation(fields: [authorId], references: [id])
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([published])
  @@index([publishedAt])
  @@map("blog_posts")
}

/// Knowledge bank item — acts, rules, forms, circulars, and bulletins.
model Resource {
  id            String       @id @default(cuid())
  type          ResourceType
  title         String
  category      String       // e.g. "Income Tax", "GST", "Companies Act"
  bodyOrFileUrl String?      // Inline Markdown body OR S3 URL for a PDF
  createdAt     DateTime     @default(now())

  @@index([type])
  @@index([category])
  @@map("resources")
}

/// Immutable compliance audit trail. Never update or delete rows here.
/// actorId is nullable to support system-generated actions (cron jobs, webhooks).
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String   // e.g. "DOCUMENT_DOWNLOAD", "CASE_STATUS_CHANGE", "INVOICE_PAID"
  entity    String   // Model name, e.g. "Document", "Case", "Invoice"
  entityId  String   // CUID of the affected row
  metadata  Json?    // IP address, before/after values, etc.
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// =============================================================================
// Knowledge Bank Models (2026–2027 Regulatory Intelligence)
// =============================================================================

enum KnowledgeDocType {
  ACT
  RULE
  NOTIFICATION
  CIRCULAR
  ORDER
  INSTRUCTION
  ADVISORY
  PRESS_RELEASE
  AMENDMENT
  FORM
  UTILITY
  CALCULATOR
  SCHEME
  JUDGMENT
  BULLETIN
}

enum DocLegislationStatus {
  CURRENT
  HISTORICAL
  AMENDED
  SUPERSEDED
  REPEALED
}

enum ReviewStatus {
  FETCHED
  PARSED
  PENDING_REVIEW
  APPROVED
  REJECTED
  PUBLISHED
}

enum SourceStatus {
  HEALTHY
  WARNING
  ERROR
  PAUSED
}

enum AuthorityType {
  CBDT
  CBIC
  GSTN
  MCA
  RBI
  SEBI
  IBBI
  LABOUR_MINISTRY
  GAZETTE_OF_INDIA
  STATE_GOVT
  HIGH_COURT
  SUPREME_COURT
  OTHER
}

model KnowledgeCategory {
  id           String              @id @default(cuid())
  name         String
  slug         String              @unique
  description  String?
  parentId     String?
  parent       KnowledgeCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     KnowledgeCategory[] @relation("CategoryHierarchy")
  icon         String?             // Lucide icon name
  displayOrder Int                 @default(0)
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  documents KnowledgeDocument[]

  @@index([slug])
  @@index([parentId])
  @@map("knowledge_categories")
}

model KnowledgeDocument {
  id                String               @id @default(cuid())
  title             String
  slug              String               @unique
  summary           String?              @db.Text
  content           String?              @db.Text // Full statutory text / markdown
  documentType      KnowledgeDocType     @default(NOTIFICATION)
  categoryId        String
  category          KnowledgeCategory    @relation(fields: [categoryId], references: [id])
  jurisdiction      String               @default("INDIA") // "INDIA" or State name
  authority         AuthorityType        @default(CBDT)
  documentNumber    String?              // e.g. "Circular No. 04/2026", "Notification No. 12/2026-CT"
  publishedDate     DateTime?
  effectiveDate     DateTime?
  expiryDate        DateTime?
  financialYear     String?              // e.g. "2026-27"
  assessmentYear    String?              // e.g. "2027-28"
  status            DocLegislationStatus @default(CURRENT)
  reviewStatus      ReviewStatus         @default(PUBLISHED)
  officialSourceUrl String?
  documentUrl       String?              // Official PDF/Gazette link
  sourceDomain      String?              // e.g. "incometax.gov.in", "cbic.gov.in"
  isOfficial        Boolean              @default(true)
  isFeatured        Boolean              @default(false)
  isHistorical      Boolean              @default(false)
  isSuperseded      Boolean              @default(false)
  supersededById    String?
  supersededBy      KnowledgeDocument?   @relation("DocSuperseded", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes        KnowledgeDocument[]  @relation("DocSuperseded")
  version           Int                  @default(1)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  lastVerifiedAt    DateTime?            @default(now())

  amendments        LegalAmendment[]
  tags              KnowledgeDocumentTag[]
  reviews           AdminReview[]

  @@index([slug])
  @@index([documentType])
  @@index([categoryId])
  @@index([authority])
  @@index([status])
  @@index([publishedDate])
  @@index([financialYear])
  @@map("knowledge_documents")
}

model LegalAmendment {
  id              String            @id @default(cuid())
  documentId      String
  document        KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  amendmentNumber String?
  title           String
  description     String?           @db.Text
  effectiveDate   DateTime?
  notificationId  String?
  previousText    String?           @db.Text
  newText         String?           @db.Text
  createdAt       DateTime          @default(now())

  @@index([documentId])
  @@map("legal_amendments")
}

model KnowledgeSource {
  id                 String        @id @default(cuid())
  name               String
  domain             String        @unique
  baseUrl            String
  authorityType      AuthorityType
  syncFrequencyHours Int           @default(6)
  isEnabled          Boolean       @default(true)
  status             SourceStatus  @default(HEALTHY)
  lastSync           DateTime?
  lastSuccessfulSync DateTime?
  errorLog           String?       @db.Text
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  syncRuns SyncRun[]

  @@map("knowledge_sources")
}

model SyncRun {
  id               String          @id @default(cuid())
  sourceId         String
  source           KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  startedAt        DateTime        @default(now())
  completedAt      DateTime?
  status           String          @default("IN_PROGRESS") // "SUCCESS", "FAILED", "PARTIAL"
  documentsFound   Int             @default(0)
  documentsCreated Int             @default(0)
  documentsUpdated Int             @default(0)
  documentsSkipped Int             @default(0)
  errorLog         String?         @db.Text

  @@index([sourceId])
  @@index([startedAt])
  @@map("knowledge_sync_runs")
}

model ComplianceDeadlineItem {
  id            String               @id @default(cuid())
  title         String
  category      String               // "INCOME_TAX", "GST", "MCA", "TDS", "EPF_ESIC", "ADVANCE_TAX"
  description   String?              @db.Text
  dueDate       DateTime
  originalDate  DateTime?            // If extended, tracks the original statutory deadline
  isExtended    Boolean              @default(false)
  extensionNote String?
  period        String?              // e.g. "Monthly (July 2026)", "Q1 (Apr-Jun 2026)", "Annual AY 2026-27"
  entityType    String?              // "ALL", "CORPORATE", "NON_AUDIT", "AUDIT", "INDIVIDUAL"
  form          String?              // "GSTR-3B", "ITR-6", "26Q", "MGT-7"
  section       String?              // "Section 139(1)", "Section 39"
  sourceUrl     String?
  status        DocLegislationStatus @default(CURRENT)
  financialYear String               @default("2026-27")
  priority      String               @default("STANDARD") // "CRITICAL", "HIGH", "STANDARD"
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([dueDate])
  @@index([category])
  @@index([financialYear])
  @@map("compliance_deadline_items")
}

model TaxRateItem {
  id            String    @id @default(cuid())
  taxType       String    // "INCOME_TAX", "TDS", "TCS", "GST", "CORPORATE_TAX", "DEPRECIATION", "CAPITAL_GAINS"
  category      String    // e.g. "Section 115BAC Slabs", "Section 194J Technical Services", "GST HSN 8471"
  subCategory   String?
  rate          String    // e.g. "10%", "25.17%", "0.1%", "20%"
  threshold     String?   // e.g. "₹30,000 per annum", "₹50 Lakhs"
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  financialYear String    @default("2026-27")
  assessmentYear String?  @default("2027-28")
  sourceUrl     String?
  notes         String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([taxType])
  @@index([financialYear])
  @@map("tax_rate_items")
}

model KnowledgeTag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  documents KnowledgeDocumentTag[]

  @@map("knowledge_tags")
}

model KnowledgeDocumentTag {
  documentId String
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tagId      String
  tag        KnowledgeTag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([documentId, tagId])
  @@map("knowledge_document_tags")
}

model AdminReview {
  id          String            @id @default(cuid())
  documentId  String
  document    KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  reviewerId  String?
  reviewer    User?             @relation(fields: [reviewerId], references: [id], onDelete: SetNull)
  status      ReviewStatus      @default(PENDING_REVIEW)
  notes       String?           @db.Text
  actionTaken String?           // "APPROVED", "REJECTED", "EDITED_AND_APPROVED"
  createdAt   DateTime          @default(now())
  reviewedAt  DateTime?

  @@index([documentId])
  @@index([status])
  @@map("admin_reviews")
}

