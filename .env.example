# =============================================================================
# Thabrez monorepo — environment variable template
#
# HOW TO USE:
#   cp .env.example .env
#   Fill in real values before running the app.
#   Never commit .env to git — it is in .gitignore.
#
# Each app also accepts an .env.local for app-specific overrides.
# Variables marked [REQUIRED] will cause startup errors if left as placeholders.
# Variables marked [OPTIONAL] are safe to leave blank in development.
# =============================================================================

# =============================================================================
# DATABASE
# Matches the docker-compose.yml defaults — change both files together.
# [REQUIRED]
# =============================================================================
DATABASE_URL="postgresql://thabrez:thabrez_dev_secret@localhost:5432/thabrez_db"

# =============================================================================
# REDIS
# Used by BullMQ for background job queues (deadline reminders, notifications).
# [REQUIRED]
# =============================================================================
REDIS_URL="redis://localhost:6379"

# =============================================================================
# API SERVER (apps/api — NestJS)
# [REQUIRED]
# =============================================================================
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed CORS origins
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# =============================================================================
# AUTH  (NextAuth / Auth.js — apps/web)
# NEXTAUTH_SECRET: run `openssl rand -base64 32` to generate a strong value.
# [REQUIRED]
# =============================================================================
NEXTAUTH_SECRET="replace-me-run-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# =============================================================================
# S3-COMPATIBLE OBJECT STORAGE
# Stores client documents (PANs, ITRs, invoices, etc.).
# For local dev use MinIO (add a minio service to docker-compose if needed).
# For production use AWS S3 (ap-south-1) or Cloudflare R2.
# [REQUIRED in production] [OPTIONAL in dev if skipping file uploads]
# =============================================================================
S3_ENDPOINT="https://s3.ap-south-1.amazonaws.com"
S3_ACCESS_KEY="your-access-key-id"
S3_SECRET_KEY="your-secret-access-key"
S3_BUCKET="thabrez-documents-dev"

# =============================================================================
# PAYMENTS  (Razorpay — India-first UPI / cards / netbanking)
# Use test-mode keys (rzp_test_*) for development — no real money moves.
# Get keys from: https://dashboard.razorpay.com/app/keys
# [OPTIONAL in dev] [REQUIRED in production]
# =============================================================================
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="placeholder"
RAZORPAY_WEBHOOK_SECRET="placeholder"

# =============================================================================
# EMAIL  (Resend — transactional email)
# OTP delivery, filing status alerts, deadline reminders.
# Get a free API key at: https://resend.com/api-keys
# [OPTIONAL in dev] [REQUIRED in production]
# =============================================================================
RESEND_API_KEY="re_placeholder"
EMAIL_FROM="no-reply@thabrez.com"

# =============================================================================
# SMS / WHATSAPP  (MSG91 — India-specific, high open rates)
# Used for deadline reminder messages to clients.
# Get keys from: https://msg91.com/
# [OPTIONAL in dev] [REQUIRED in production]
# =============================================================================
MSG91_API_KEY="placeholder"
MSG91_SENDER_ID="THABREZ"
MSG91_TEMPLATE_ID="placeholder"
