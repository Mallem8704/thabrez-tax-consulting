# =============================================================================
# Thabrez Tax Consulting — Full Stack Production Environment Configuration
# =============================================================================

# 1. NODE & PORTS
NODE_ENV=production
PORT=4000
NEXT_TELEMETRY_DISABLED=1

# 2. APPLICATION AUTHENTICATION
JWT_SECRET=thabrez_production_secure_jwt_secret_32_chars_long
JWT_EXPIRATION=7d
NEXTAUTH_SECRET=thabrez_production_secure_jwt_secret_32_chars_long
NEXTAUTH_URL=https://thabrez-tax-consulting.vercel.app
ADMIN_NEXTAUTH_URL=https://thabrez-admin.vercel.app

# 3. BACKEND API ENDPOINTS
NEXT_PUBLIC_API_URL=https://thabrez-api.onrender.com/api/v1
API_URL=https://thabrez-api.onrender.com/api/v1
CORS_ORIGINS=https://thabrez-tax-consulting.vercel.app,https://thabrez-admin.vercel.app,https://thabrez-web.onrender.com,https://thabrez-admin.onrender.com,http://localhost:3000,http://localhost:3001

# 4. DATABASE & REDIS
POSTGRES_USER=thabrez
POSTGRES_PASSWORD=thabrez_production_secret_password_2026
POSTGRES_DB=thabrez_db
DATABASE_URL=postgresql://thabrez:thabrez_production_secret_password_2026@localhost:5432/thabrez_db
REDIS_URL=redis://localhost:6379

# 5. PUBLIC CONTACT HELPLINE
NEXT_PUBLIC_CONTACT_PHONE_1=+918802222422
NEXT_PUBLIC_CONTACT_PHONE_2=+917972222422
