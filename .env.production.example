# =============================================================================
# Thabrez Tax Consulting — Production Environment Configuration
# =============================================================================

# 1. DATABASE (PostgreSQL)
POSTGRES_USER=thabrez_prod_user
POSTGRES_PASSWORD=generate_a_strong_64_character_password_here
POSTGRES_DB=thabrez_db_prod

# 2. APPLICATION AUTHENTICATION
JWT_SECRET=generate_strong_32_char_jwt_secret_key_here
JWT_EXPIRATION=7d
NEXTAUTH_SECRET=generate_strong_32_char_nextauth_secret_key_here
NEXTAUTH_URL=https://thabreztaxconsulting.com
ADMIN_NEXTAUTH_URL=https://admin.thabreztaxconsulting.com

# 3. PUBLIC API ENDPOINTS
NEXT_PUBLIC_API_URL=https://thabreztaxconsulting.com/api/v1
CORS_ORIGINS=https://thabreztaxconsulting.com,https://admin.thabreztaxconsulting.com

# 4. PAYMENT GATEWAY (Razorpay Live Keys)
RAZORPAY_KEY_ID=rzp_live_your_actual_key_id
RAZORPAY_KEY_SECRET=your_actual_live_key_secret

# 5. AWS S3 DOCUMENT STORAGE (ap-south-1 Mumbai)
S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
S3_ACCESS_KEY=your_aws_iam_access_key
S3_SECRET_KEY=your_aws_iam_secret_key
S3_BUCKET=thabrez-documents-production

# 6. TRANSACTIONAL EMAIL (Resend / AWS SES)
RESEND_API_KEY=re_your_live_resend_api_key
EMAIL_FROM=notifications@thabreztaxconsulting.com
