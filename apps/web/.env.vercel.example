# =============================================================================
# Vercel Environment Variables — Public Web & Client Portal (apps/web)
# Copy & paste this entire block into Vercel -> Project Settings -> Environment Variables
# =============================================================================

NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# 1. Connected Render Backend API URL
NEXT_PUBLIC_API_URL=https://thabrez-api.onrender.com/api/v1
API_URL=https://thabrez-api.onrender.com/api/v1

# 2. NextAuth Authentication (Update with your actual Vercel domain or custom domain)
NEXTAUTH_URL=https://thabrez-tax-consulting.vercel.app
NEXTAUTH_SECRET=thabrez_production_secure_jwt_secret_32_chars_long

# 3. Optional Public Contact & Company Phone
NEXT_PUBLIC_CONTACT_PHONE_1=+918802222422
NEXT_PUBLIC_CONTACT_PHONE_2=+917972222422
